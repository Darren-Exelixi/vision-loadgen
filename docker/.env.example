# Standalone runs only; copy to .env and fill in. Never commit .env.
# Running beside a worker needs none of this: the worker's own settings are used.
LOADGEN_ENVIRONMENT=staging

# Docker (FLAGGED: confirm against the target deployment)
DOCKER_NETWORK=vision_network
FRAMES_SOURCE=/srv/vision/frames
FRAMES_MOUNT_PATH=/data/frames
# The workers' EVENTS_DIR and where it lives on the host; used to delete synthetic event files.
EVENTS_SOURCE=/srv/vision/events
EVENTS_DIR=/app/events

KAFKA_BOOTSTRAP_SERVERS=kafka:7010
KAFKA_TOPIC=exelixi.frames.raw

# Postgres server URL without a database name, as in the workers' POSTGRES_URL. Module databases
# (crowd_gathering_db, emotion_detection_db, frs_db) and vision_main_db are derived from it.
POSTGRES_URL=postgresql://user:password@vision_main_postgres:5432
# Optional explicit URLs; each overrides the derived one.
VISION_MAIN_DATABASE_URL=
CROWD_DATABASE_URL=
SENTIMENT_DATABASE_URL=
ATTENDANCE_DATABASE_URL=

# Same secret the workers use to verify service tokens
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# GPU sizing shared by the modules (a module may override these in its own settings)
CAMERAS_PER_WORKER=10
VRAM_PER_WORKER_MB=1000

# Real camera whose frames are stacked; empty = the first worker's freshest live camera
LOADGEN_TEMPLATE_CAMERA_ID=
TIMEZONE=UTC

# Prometheus metrics for Grafana (monitoring/); empty = off. Needs `--service-ports` on `compose run`.
LOADGEN_METRICS_PORT=
