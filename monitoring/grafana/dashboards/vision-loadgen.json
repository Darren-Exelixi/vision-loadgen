{
  "uid": "vision-loadgen",
  "title": "vision-loadgen",
  "description": "Load generator runs: published load, worker staleness and lag, GPU model copies, verdicts.",
  "tags": [
    "vision-loadgen",
    "load-testing"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "loadgen-prometheus"
        },
        "query": {
          "query": "label_values(loadgen_run_info, run_id)",
          "refId": "run_id"
        },
        "definition": "label_values(loadgen_run_info, run_id)",
        "refresh": 2,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "loadgen-prometheus"
        },
        "query": {
          "query": "label_values(loadgen_worker_up{run_id=\"$run_id\"}, worker)",
          "refId": "worker"
        },
        "definition": "label_values(loadgen_worker_up{run_id=\"$run_id\"}, worker)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Stages",
        "datasource": {
          "type": "prometheus",
          "uid": "loadgen-prometheus"
        },
        "enable": true,
        "iconColor": "rgba(120, 120, 255, 0.35)",
        "expr": "loadgen_stage_info{run_id=\"$run_id\"}",
        "step": "5s",
        "titleFormat": "{{stage}}",
        "tagKeys": "stage_index",
        "useValueForTime": false
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Runs",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Runs in the selected time range",
      "description": "Click a run id to open that run with the time range set to its window.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "loadgen-prometheus"
          },
          "refId": "A",
          "expr": "max by (run_id, scenario, scenario_type, environment) (max_over_time(loadgen_run_start_time_seconds[$__range])) * 1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "loadgen-prometheus"
          },
          "refId": "B",
          "expr": "max by (run_id) (max_over_time(timestamp(loadgen_run_start_time_seconds)[$__range:15s])) * 1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "loadgen-prometheus"
          },
          "refId": "C",
          "expr": "max by (run_id) (max_over_time(loadgen_stage_index[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "loadgen-prometheus"
          },
          "refId": "D",
          "expr": "max by (run_id) (max by (run_id, scenario, scenario_type, environment) (max_over_time(loadgen_run_start_time_seconds[$__range]))) * 1000 - 30000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "loadgen-prometheus"
          },
          "refId": "E",
          "expr": "max by (run_id) (max_over_time(timestamp(loadgen_run_start_time_seconds)[$__range:15s])) * 1000 + 30000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "run_id": 0,
              "scenario": 1,
              "scenario_type": 2,
              "environment": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "Value #E": 8
            },
            "renameByName": {
              "scenario_type": "type",
              "Value #A": "started",
              "Value #B": "last seen",
              "Value #C": "stages reached",
              "Value #D": "from_ms",
              "Value #E": "to_ms"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "started",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(from_ms|to_ms)$"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this run",
                    "url": "/d/vision-loadgen/vision-loadgen?var-run_id=${__data.fields.run_id}&var-worker=$__all&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "loadgen-prometheus"
